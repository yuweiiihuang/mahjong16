// Selected calls and dependencies; arrows point from caller to service/dependency.
// Regenerate from the repository root: dot -Tpng docs/architecture/diagram.gv -o docs/architecture/diagram.png
digraph Mahjong16 {
    graph [rankdir=LR, fontname="Helvetica", fontsize=14, labelloc="t",
           label="Mahjong16: CLI, Web, and Private Records (2026-10-14)\nSelected calls / dependencies; not a complete import graph"];
    node [shape=box, fontname="Helvetica", fontsize=11, style="rounded,filled",
          fillcolor="#f0f5f1", color="#557563"];
    edge [color="#65736b", arrowsize=0.7];

    cli [label="main.py\nCLI entrypoint", shape=tab];
    browser [label="ui/web/\nQinghe browser UI", shape=tab];
    replay [label="app/replay.py\nRecord / verify / export / backup / dataset", shape=tab];
    scripts [label="scripts/\nLeague / benchmark / tuning / CSV analysis", shape=tab];

    subgraph cluster_app {
        label="Application"; color="#b3c7ba";
        runtime [label="app/runtime.py\nCLI sessions and CSV summaries"];
        console [label="ui/console.py\nRich rendering"];
        web [label="app/web.py\nHTTP handler and WebTable"];
        rooms [label="app/web_rooms.py\nRoomRegistry / seats / scheduling"];
        store [label="app/hand_store.py\nPersistentHandRecorder / SQLite"];
        dataset [label="app/training_export.py\nVisible observations and decision facts"];
        table [label="app/table.py\nDealer / round / cumulative points"];
        bots [label="bots/\nHuman / Auto / Greedy / Random / RuleBot"];
    }
    subgraph cluster_domain {
        label="Deterministic domain"; color="#b3c7ba";
        env [label="domain/gameplay/game_env.py\nDeal / draw / discard / reactions"];
        rules [label="domain/rules/\ndomain/tiles/ and domain/table/\nRules / hand algorithms / wall / seats"];
        scoring [label="domain/scoring/\nState / rule pipeline / payments"];
        recording [label="domain/gameplay/recording.py\nHandRecorder / replay_hand"];
        configs [label="configs/rules/profiles/\nconfigs/scoring/\nRule toggles and scoring assets"];
    }
    rl [label="rl/\nSelf-play / buffer / optional PyTorch net\ntrain_loop remains a stub"];
    sqlite [label="Private SQLite hand records\nCLI default: data/hands.sqlite3", shape=cylinder];

    cli -> runtime;
    runtime -> {console table bots env scoring};
    browser -> web [label="HTTP / JSON", style=dashed];
    web -> {rooms store table bots env scoring};
    rooms -> web [label="WebTable methods"];
    rooms -> store;
    store -> recording;
    store -> sqlite;
    replay -> {store recording dataset bots env};
    dataset -> {recording env};
    recording -> {env scoring};
    env -> rules;
    scoring -> {rules configs};
    rules -> configs;
    bots -> rules;
    scripts -> {table bots env scoring};
    rl -> env [label="injected env_ctor", style=dashed];
}
